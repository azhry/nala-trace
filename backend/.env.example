# Non-secret local defaults. Copy to backend/.env only when using a local secret store.
AUTH_LISTEN_ADDR=:8080
FRONTEND_URL=http://localhost:5173/
AUTH_ALLOWED_ORIGIN=http://localhost:5173
MONGO_ENABLED=false
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DATABASE=nala_trace
MONGO_CONNECT_TIMEOUT=5s
MONGO_PING_TIMEOUT=2s
MONGO_DISCONNECT_TIMEOUT=5s
CASDOOR_ISSUER=https://casdoor.nalanirvana.com
CASDOOR_USERINFO_ENDPOINT=https://casdoor.nalanirvana.com/api/get-account
CASDOOR_SCOPES=openid profile email
CASDOOR_REDIRECT_URL=http://localhost:8080/api/auth/callback
SESSION_COOKIE_NAME=nala_trace_session
SESSION_TTL=24h
VAULT_ENABLED=false
VAULT_ADDR=http://127.0.0.1:8200
VAULT_KV_MOUNT=kv
VAULT_CONFIG_PATH=nala-trace/config

# Secret values are intentionally omitted. Supply them from a local secret store.
# MONGO_USERNAME=
# MONGO_PASSWORD=
# CODEX_TRACE_API_TOKEN=
# CASDOOR_CLIENT_ID=
# CASDOOR_CLIENT_SECRET=
# SESSION_SECRET=
# VAULT_TOKEN=
