# Non-secret local defaults. Copy to backend/.env only when using a local secret store.
AUTH_LISTEN_ADDR=:8080
FRONTEND_URL=http://localhost:5173/
AUTH_ALLOWED_ORIGIN=http://localhost:5173
MONGO_ENABLED=false
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DATABASE=nala_trace
MONGO_CONNECT_TIMEOUT=5s
MONGO_PING_TIMEOUT=2s
MONGO_DISCONNECT_TIMEOUT=5s
NALA_LABS_AUTH_URL=http://127.0.0.1:18080
SESSION_COOKIE_NAME=nala_trace_session
SESSION_TTL=24h
VAULT_ENABLED=false
VAULT_ADDR=http://127.0.0.1:8200
VAULT_KV_MOUNT=kv
VAULT_KV_PATH=nala-trace/config

# Secret values are intentionally omitted. Supply them from a local secret store.
# MONGO_USERNAME=
# MONGO_PASSWORD=
# CODEX_TRACE_API_TOKEN=
# SESSION_SECRET=
# VAULT_TOKEN=
# VAULT_ROLE_ID=
# VAULT_SECRET_ID=
