# Non-secret local defaults. Copy to backend/.env only when using a local secret store.
AUTH_LISTEN_ADDR=:3003
FRONTEND_URL=http://localhost:5005/
AUTH_ALLOWED_ORIGIN=http://localhost:5005
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DATABASE=nala_trace
MONGO_CONNECT_TIMEOUT=5s
MONGO_PING_TIMEOUT=2s
MONGO_DISCONNECT_TIMEOUT=5s
NALA_LABS_AUTH_URL=http://127.0.0.1:8080
POSTGRESQL_ADDRESS=127.0.0.1:5432
REDIS_ADDRESS=127.0.0.1:6379
KAFKA_ADDRESS=127.0.0.1:9092
HEALTHCHECK_TIMEOUT=2s
VAULT_ADDR=http://127.0.0.1:8200
VAULT_KV_MOUNT=secret
VAULT_KV_PATH=nala-labs/nala-trace

# Secret values are intentionally omitted. Supply them from a local secret store.
# When Mongo authentication is enabled, MONGO_URI must contain the complete
# credential-bearing connection string and must come from the secret store.
# NALA_LABS_API_KEY=
# VAULT_TOKEN=
# VAULT_ROLE_ID=
# VAULT_SECRET_ID=
