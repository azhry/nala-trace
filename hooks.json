{
  "description": "Nala Trace lifecycle hooks.",
  "hooks": {
    "SessionStart": [
      {"hooks": [{"type": "command", "command": ".codex/hook-client.exe"}]}
    ],
    "UserPromptSubmit": [
      {"hooks": [{"type": "command", "command": ".codex/hook-client.exe"}]}
    ],
    "PreToolUse": [
      {"hooks": [{"type": "command", "command": ".codex/hook-client.exe"}]}
    ],
    "PostToolUse": [
      {"hooks": [{"type": "command", "command": ".codex/hook-client.exe"}]}
    ],
    "SubagentStart": [
      {"hooks": [{"type": "command", "command": ".codex/hook-client.exe"}]}
    ],
    "SubagentStop": [
      {"hooks": [{"type": "command", "command": ".codex/hook-client.exe"}]}
    ],
    "PreCompact": [
      {"hooks": [{"type": "command", "command": ".codex/hook-client.exe"}]}
    ],
    "PostCompact": [
      {"hooks": [{"type": "command", "command": ".codex/hook-client.exe"}]}
    ],
    "Stop": [
      {"hooks": [{"type": "command", "command": ".codex/hook-client.exe"}]}
    ]
  }
}
